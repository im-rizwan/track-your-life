# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# ============================================================================
# EMAILJS CONFIGURATION
# ============================================================================
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/
# 1. Create an account and verify your email
# 2. Add an email service (Gmail, Outlook, etc.)
# 3. Create an email template for OTP
# 4. Get your Public Key, Private Key, Service ID, and Template ID

# Service ID from EmailJS dashboard (e.g., service_abc123)
EMAILJS_SERVICE_ID=your_service_id

# Template ID from EmailJS dashboard (e.g., template_xyz789)
EMAILJS_TEMPLATE_ID=your_template_id

# Public Key from EmailJS dashboard (Account > API Keys)
EMAILJS_PUBLIC_KEY=your_public_key

# Private Key from EmailJS dashboard (Account > API Keys)
EMAILJS_PRIVATE_KEY=your_private_key

# ============================================================================
# EMAILJS TEMPLATE VARIABLES (Required in your template)
# ============================================================================
# Your EmailJS template should include these variables:
# - {{to_email}} - Recipient email address
# - {{to_name}} - Recipient name (defaults to "User")
# - {{subject}} - Email subject line
# - {{message}} - Contextual message about the OTP
# - {{otp_code}} - The 6-digit OTP code (MAIN VARIABLE)
# - {{purpose}} - Purpose of the OTP (e.g., "email verification")
# - {{app_name}} - Application name ("Muhasabah")
# - {{expiry_minutes}} - OTP expiry time ("2" minutes)
